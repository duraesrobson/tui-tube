{
  "name": "tui-tube",
  "version": "1.0.0",
  "description": "YouTube to MP3/MP4 converter with terminal-style UI",
  "homepage": "https://github.com/duraesrobson/tui-tube",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duraesrobson/tui-tube.git"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:win": "tsc && vite build && electron-builder --win",
    "build:linux": "tsc && vite build && electron-builder --linux",
    "preview": "vite preview",
    "android:sync": "vite build && cap sync android",
    "android:build": "vite build && cap sync android && cd android && ./gradlew assembleRelease",
    "android:install": "npm run android:build && \"$HOME/Android/Sdk/platform-tools/adb\" install -r android/app/build/outputs/apk/release/app-release.apk"
  },
  "keywords": [
    "youtube",
    "converter",
    "mp3",
    "mp4",
    "electron"
  ],
  "author": "tui-tube",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "typescript": "^5.3.3",
    "vite": "^8.1.5",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "electron-log": "^5.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sass": "^1.69.5"
  }
}
